{
  "name": "next-app-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy:env": "node ./scripts/write-env.mjs",
    "start:dev": "pnpm copy:env development && next dev --port 8080 --turbopack",
    "build:dev": "pnpm copy:env development && next build",
    "type:check": "npx tsc --watch --noEmit",
    "update:package": "npx npm-check-updates --interactive",
    "start": "next start --port 8080",
    "format": "prettier --write .",
    "lint": "next lint",
    "gen:api:dev": "node ./scripts/api-generator-script.mjs development && pnpm prettier --write ./src/generators/api-generator.d.ts"
  },
  "packageManager": "pnpm@10.16.1",
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "async": "^3.2.6",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "15.5.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.35.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "openapi-typescript": "^7.9.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5"
  }
}
